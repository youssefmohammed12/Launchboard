{
  "name": "@launchboard/server",
  "version": "0.1.0",
  "private": true,
  "description": "Launchboard HTTP API foundation: configuration, health, errors and strict request validation.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:migrate:compiled": "node dist/db/migrate-cli.js",
    "db:verify-live": "tsx src/db/verify-live-cli.ts"
  },
  "dependencies": {
    "@launchboard/domain": "*",
    "@node-rs/argon2": "^2.2.2",
    "@types/cookie": "^0.6.0",
    "cookie": "^0.7.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "vitest": "^4.1.12"
  }
}

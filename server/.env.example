NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Runtime application database block.
# Leave all runtime DB_* settings unset to run the process without a
# database; /api/health still works and /api/ready returns 503.
# DB_NAME must be exactly launchboard.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=launchboard
DB_USER=launchboard_app
DB_PASSWORD=

# Enable TLS for public cloud databases such as TiDB Cloud Serverless.
# When enabled, Node verifies the server certificate using trusted root CAs.
# Leave false/unset for local development databases.
# DB_SSL=true
#
# Optional custom CA for providers such as Aiven. When supplied, DB_SSL is enabled.
# DB_SSL_CA=

# Migration-only database credentials.
# Required only for `npm run db:migrate`. They never fall back to DB_USER or
# DB_PASSWORD, and the application server never uses them.
# DB_HOST, DB_PORT and DB_NAME above are reused.
DB_MIGRATION_USER=launchboard_migrator
DB_MIGRATION_PASSWORD=

# Authentication
# CSRF_SECRET must be base64url encoded and at least 32 decoded bytes
# CSRF_SECRET=
# TRUSTED_ORIGINS must be comma-separated exact origins (e.g. http://127.0.0.1:5173)
# TRUSTED_ORIGINS=http://127.0.0.1:5173

# Transactional email (optional for local health/dev; required for registration,
# verification resend, and password-reset requests).
# Gmail SMTP uses the dedicated Gmail address and its 16-character app password.
# Keep SMTP_PASS server-side; never use a VITE_* name or commit a real value.
# SMTP_USER=launchboard.notifications@gmail.com
# SMTP_PASS=
# APP_BASE_URL=https://launchboard-drab.vercel.app

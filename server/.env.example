NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Runtime application database block.
# Leave all five DB_* runtime settings unset to run the process without a
# database; /api/health still works and /api/ready returns 503.
# DB_NAME must be exactly launchboard.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=launchboard
DB_USER=launchboard_app
DB_PASSWORD=

# Migration-only database credentials.
# Required only for `npm run db:migrate`. They never fall back to DB_USER or
# DB_PASSWORD, and the application server never uses them.
# DB_HOST, DB_PORT and DB_NAME above are reused.
DB_MIGRATION_USER=launchboard_migrator
DB_MIGRATION_PASSWORD=
